<Window x:Class="DriveTriage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:utils="clr-namespace:DriveTriage.Utils"
        mc:Ignorable="d"
        Title="Drive Triage" Height="600" Width="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <utils:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <utils:DriveInfoConverter x:Key="DriveInfoConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <TabControl>
            <!-- Scan Tab -->
            <TabItem Header="Scan">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drive Selection -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Select Drive:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AvailableDrives}"
                                  SelectedItem="{Binding SelectedDrive}"
                                  Height="30"
                                  MaxWidth="600"
                                  HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource DriveInfoConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Scan" Width="100" Margin="0,0,10,0"
                                Command="{Binding ScanCommand}"/>
                        <Button Content="Cancel" Width="100" 
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>

                    <!-- Progress Bar with Percentage -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <ProgressBar Height="25" 
                                     Value="{Binding ProgressPercent}" 
                                     Maximum="100"
                                     IsIndeterminate="{Binding IsScanning}"/>
                        <TextBlock HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="False">
                                            <Setter Property="Text" Value="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Text" Value="Scanning..."/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsScanning}" Value="False"/>
                                                <Condition Binding="{Binding ProgressPercent}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Status TextBlock -->
                    <Border Grid.Row="3" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Padding="10,5"
                            Margin="0,0,0,10"
                            Background="#F9F9F9">
                        <TextBlock Text="{Binding StatusText}" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}"/>
                    </Border>

                    <!-- ListViews for Files and Folders -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Largest Files -->
                        <GroupBox Grid.Column="0" Header="Largest Files" Margin="0,0,5,0">
                            <ListView ItemsSource="{Binding LargestFiles}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Path" Width="200" 
                                                        DisplayMemberBinding="{Binding Path}"/>
                                        <GridViewColumn Header="Size" Width="80" 
                                                        DisplayMemberBinding="{Binding Size}"/>
                                        <GridViewColumn Header="Last Modified" Width="120" 
                                                        DisplayMemberBinding="{Binding LastModified}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>

                        <!-- Largest Folders -->
                        <GroupBox Grid.Column="1" Header="Largest Folders" Margin="5,0,0,0">
                            <ListView ItemsSource="{Binding LargestFolders}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Path" Width="200" 
                                                        DisplayMemberBinding="{Binding Path}"/>
                                        <GridViewColumn Header="Size" Width="80" 
                                                        DisplayMemberBinding="{Binding Size}"/>
                                        <GridViewColumn Header="Last Modified" Width="120" 
                                                        DisplayMemberBinding="{Binding LastModified}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Recommendations Tab -->
            <TabItem Header="Recommendations">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Scan for Cleanup" Width="140" Margin="0,0,10,0"
                                Command="{Binding ScanBucketsCommand}"/>
                        <Button Content="Cancel" Width="100"
                                Command="{Binding CancelBucketsCommand}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Buckets List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State -->
                            <TextBlock Text="Click 'Scan for Cleanup' to find reclaimable space" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,50,0,0"
                                       FontSize="16" 
                                       Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CleanupBuckets.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Buckets Items -->
                            <ItemsControl ItemsSource="{Binding CleanupBuckets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CCCCCC" 
                                            BorderThickness="1" 
                                            CornerRadius="5" 
                                            Padding="15" 
                                            Margin="0,0,0,10"
                                            Background="White">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Bucket Name -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Margin="0,0,0,5"/>

                                                <!-- Clean Button -->
                                                <Button Grid.Row="0" Grid.Column="1" 
                                                    Content="Clean" 
                                                    Width="100" 
                                                    Height="30"
                                                    Command="{Binding DataContext.CleanBucketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                                <!-- Description -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Description}" 
                                                       Foreground="Gray" 
                                                       Margin="0,0,0,10"
                                                       TextWrapping="Wrap"/>

                                                <!-- Statistics -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                        Orientation="Horizontal" 
                                                        Margin="0,0,0,5">
                                                    <TextBlock Text="Items: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ItemCount}" Margin="0,0,20,0"/>
                                                    <TextBlock Text="Reclaimable: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ReclaimableSize}" 
                                                           Foreground="#2E7D32" 
                                                           FontWeight="Bold"/>
                                                </StackPanel>

                                                <!-- Status -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding StatusMessage}" 
                                                       FontStyle="Italic" 
                                                       Foreground="#666666"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Apps Tab -->
            <TabItem Header="Apps">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Scan Apps" Width="120" Margin="0,0,10,0"
                                Command="{Binding ScanAppsCommand}"/>
                        <Button Content="Cancel" Width="100" Margin="0,0,10,0"
                                Command="{Binding CancelAppsCommand}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Search:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding AppsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="25"/>
                    </Grid>

                    <!-- Apps List -->
                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding FilteredApps}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F5F5F5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application Name" 
                                                Binding="{Binding DisplayName}" 
                                                Width="2*"/>
                            <DataGridTextColumn Header="Publisher" 
                                                Binding="{Binding Publisher}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Version" 
                                                Binding="{Binding DisplayVersion}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="Size" 
                                                Binding="{Binding FormattedSize}" 
                                                Width="80"/>
                            <DataGridTextColumn Header="Install Date" 
                                                Binding="{Binding FormattedInstallDate}" 
                                                Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Uninstall" 
                                                Width="100"
                                                Height="25"
                                                Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding UninstallString, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Empty State -->
                    <TextBlock Grid.Row="3"
                               Text="Click 'Scan Apps' to enumerate installed applications" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16" 
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- Restore Tab -->
            <TabItem Header="Restore">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Load Sessions" Width="120" Margin="0,0,10,0"
                                Command="{Binding LoadRestorableSessionsCommand}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Sessions List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- System Cleanup Section Header -->
                            <TextBlock Text="System Cleanup" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,10"/>

                            <!-- System Cleanup Cards Grid -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Recycle Bin Card -->
                                <Border Grid.Column="0"
                                        BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="15" 
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="🗑️ Recycle Bin" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding SystemCleanupInfo.FormattedRecycleBinSize, FallbackValue='Loading...'}" 
                                                   FontSize="18" 
                                                   Foreground="#2E7D32"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="{Binding SystemCleanupInfo.RecycleBinItemCount, StringFormat='{}{0} items', FallbackValue='0 items'}" 
                                                   Foreground="Gray"
                                                   Margin="0,0,0,10"/>

                                        <Button Grid.Row="3" 
                                                Content="Empty Recycle Bin" 
                                                Command="{Binding EmptyRecycleBinCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>

                                <!-- Quarantine Card -->
                                <Border Grid.Column="2"
                                        BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="15" 
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="📦 Quarantine" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding SystemCleanupInfo.FormattedQuarantineSize, FallbackValue='Loading...'}" 
                                                   FontSize="18" 
                                                   Foreground="#1976D2"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="{Binding SystemCleanupInfo.QuarantineItemCount, StringFormat='{}{0} items', FallbackValue='0 items'}" 
                                                   Foreground="Gray"
                                                   Margin="0,0,0,10"/>

                                        <Button Grid.Row="3" 
                                                Content="Clean Quarantine" 
                                                Command="{Binding CleanQuarantineCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>

                                <!-- NVIDIA Cache Card -->
                                <Border Grid.Column="4"
                                        BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="15" 
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="🎮 NVIDIA Cache" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding SystemCleanupInfo.FormattedNvidiaCacheSize, FallbackValue='Loading...'}" 
                                                   FontSize="18" 
                                                   Foreground="#76B900"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="Driver cache &amp; downloads" 
                                                   Foreground="Gray"
                                                   Margin="0,0,0,10"/>

                                        <Button Grid.Row="3" 
                                                Content="Purge NVIDIA Cache" 
                                                Command="{Binding PurgeNvidiaCacheCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Refresh Button -->
                            <Button Content="🔄 Refresh System Info" 
                                    Width="180" 
                                    Height="35"
                                    Command="{Binding RefreshSystemCleanupInfoCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,20"/>

                            <!-- System Maintenance Section Header -->
                            <TextBlock Text="System Maintenance" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,10"/>

                            <!-- System Maintenance Cards Grid -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- DISM Component Cleanup Card -->
                                <Border Grid.Column="0"
                                        BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="15" 
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="🛠️ DISM Cleanup" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="Component Store" 
                                                   FontSize="16" 
                                                   Foreground="#F57C00"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="Clean Windows components" 
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <Button Grid.Row="3" 
                                                Content="Run DISM Cleanup" 
                                                Command="{Binding RunDismComponentCleanupCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>

                                <!-- Windows Update Cache Card -->
                                <Border Grid.Column="2"
                                        BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="15" 
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="🔄 Windows Update" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding SystemMaintenanceInfo.FormattedWindowsUpdateCacheSize, FallbackValue='Loading...'}" 
                                                   FontSize="16" 
                                                   Foreground="#0078D4"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="Download cache" 
                                                   Foreground="Gray"
                                                   Margin="0,0,0,10"/>

                                        <Button Grid.Row="3" 
                                                Content="Clear Update Cache" 
                                                Command="{Binding ClearWindowsUpdateCacheCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Padding="10,5"/>
                                    </Grid>
                                </Border>

                                <!-- Shadow Storage Info Card -->
                                <Border Grid.Column="4"
                                        BorderBrush="#CCCCCC" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Padding="15" 
                                        Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="💾 Shadow Storage" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" 
                                                   Text="{Binding SystemMaintenanceInfo.ShadowStorageInfo.FormattedTotalUsed, FallbackValue='Loading...'}" 
                                                   FontSize="16" 
                                                   Foreground="#7B1FA2"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="Restore points &amp; backups" 
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>

                                        <Button Grid.Row="3" 
                                                Content="View Details" 
                                                Command="{Binding ShowShadowStorageDetailsCommand}"
                                                Style="{StaticResource {x:Type Button}}"
                                                Padding="10,5"
                                                IsEnabled="False"
                                                ToolTip="Read-only information - use Windows System Properties to manage"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Refresh Maintenance Button -->
                            <Button Content="🔄 Refresh Maintenance Info" 
                                    Width="200" 
                                    Height="35"
                                    Command="{Binding RefreshSystemMaintenanceInfoCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,20"/>

                            <!-- Section Header -->
                            <TextBlock Text="Restorable Cleanup Sessions" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,10"/>

                            <!-- Empty State -->
                            <TextBlock Text="Click 'Load Sessions' to view restorable cleanup operations"
                                       HorizontalAlignment="Center" 
                                       Margin="0,50,0,0"
                                       FontSize="16" 
                                       Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RestorableSessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Session Items -->
                            <ItemsControl ItemsSource="{Binding RestorableSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CCCCCC" 
                                                BorderThickness="1" 
                                                CornerRadius="5" 
                                                Padding="15" 
                                                Margin="0,0,0,10"
                                                Background="White">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Session Name -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                                           Text="{Binding BucketName}" 
                                                           FontSize="16" 
                                                           FontWeight="Bold" 
                                                           Margin="0,0,0,5"/>

                                                <!-- Restore Button -->
                                                <Button Grid.Row="0" Grid.Column="1" 
                                                        Content="Restore All" 
                                                        Width="120" 
                                                        Height="30"
                                                        Command="{Binding DataContext.RestoreSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Date/Time -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding FormattedTimestamp, StringFormat='Date: {0}'}" 
                                                           Foreground="Gray" 
                                                           Margin="0,0,0,10"/>

                                                <!-- Statistics -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                            Orientation="Horizontal" 
                                                            Margin="0,0,0,5">
                                                    <TextBlock Text="Restorable Items: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RestorableCount}" Margin="0,0,20,0" Foreground="#2E7D32" FontWeight="Bold"/>
                                                    <TextBlock Text="Original Size: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!-- Session ID -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding SessionId, StringFormat='Session ID: {0}'}" 
                                                           FontStyle="Italic" 
                                                           FontSize="10"
                                                           Foreground="#999999"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ProgramData Forensics Tab -->
            <TabItem Header="ProgramData Forensics">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Description -->
                    <Border Grid.Row="0" 
                            BorderBrush="#E3F2FD" 
                            BorderThickness="2" 
                            CornerRadius="5"
                            Padding="15" 
                            Margin="0,0,0,10"
                            Background="#E3F2FD">
                        <StackPanel>
                            <TextBlock Text="🔍 ProgramData Forensics" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Foreground="#1976D2"
                                       Margin="0,0,0,5"/>
                            <TextBlock TextWrapping="Wrap" 
                                       Foreground="#424242">
                                <Run Text="Quickly identifies the largest folders under C:\ProgramData to help you find space hogs from installed applications, caches, and logs."/>
                                <LineBreak/>
                                <Run Text="This scan is fast (1-2 levels deep) and safe - it only analyzes folder sizes, never modifies files."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Scan Button -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔍 Scan ProgramData" Width="180" Height="35" Margin="0,0,10,0"
                                Command="{Binding ScanProgramDataCommand}"
                                FontWeight="SemiBold"/>
                        <TextBlock Text="(Fast scan - only 1-2 levels deep)" 
                                   VerticalAlignment="Center" 
                                   Foreground="Gray"
                                   FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Progress Bar with Percentage -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <ProgressBar Height="25" 
                                     Value="{Binding ProgressPercent}" 
                                     Maximum="100"
                                     IsIndeterminate="{Binding IsScanning}"/>
                        <TextBlock HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="False">
                                            <Setter Property="Text" Value="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}"/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Text" Value="Scanning..."/>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsScanning}" Value="False"/>
                                                <Condition Binding="{Binding ProgressPercent}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Status TextBlock -->
                    <Border Grid.Row="3" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Padding="10,5"
                            Margin="0,0,0,10"
                            Background="#F9F9F9">
                        <TextBlock Text="{Binding StatusText}" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}"/>
                    </Border>

                    <!-- Results GroupBox -->
                    <GroupBox Grid.Row="4" Header="Largest ProgramData Folders (Top 50)">
                        <Grid>
                            <!-- Empty State -->
                            <TextBlock Text="Click 'Scan ProgramData' to analyze folder sizes" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       FontSize="16" 
                                       Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LargestProgramDataFolders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Results ListView -->
                            <ListView ItemsSource="{Binding LargestProgramDataFolders}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Folder Path" Width="450">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Path}" 
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Path}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Size" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Size}" 
                                                               FontWeight="SemiBold"
                                                               Foreground="#1976D2"
                                                               HorizontalAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Last Modified" Width="150" 
                                                        DisplayMemberBinding="{Binding LastModified}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Install Drift Monitor Tab -->
            <TabItem Header="Install Drift Monitor">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Description -->
                    <Border Grid.Row="0" 
                            BorderBrush="#E8F5E9" 
                            BorderThickness="2" 
                            CornerRadius="5"
                            Padding="15" 
                            Margin="0,0,0,10"
                            Background="#E8F5E9">
                        <StackPanel>
                            <TextBlock Text="📊 Install Drift Monitor" 
                                       FontWeight="Bold" 
                                       FontSize="16" 
                                       Foreground="#2E7D32"
                                       Margin="0,0,0,5"/>
                            <TextBlock TextWrapping="Wrap" 
                                       Foreground="#424242">
                                <Run Text="Track storage growth over time by taking periodic snapshots of key system folders."/>
                                <LineBreak/>
                                <Run Text="Monitors: C:\Program Files, C:\Program Files (x86), C:\ProgramData, and AppData\Local."/>
                                <LineBreak/>
                                <Run Text="Use this to identify which applications or folders are consuming the most disk space over time."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="📸 Take Snapshot" Width="140" Height="35" Margin="0,0,10,0"
                                    Command="{Binding TakeSnapshotCommand}"
                                    FontWeight="SemiBold"/>
                            <Button Content="🔍 Compare Recent" Width="160" Height="35" Margin="0,0,10,0"
                                    Command="{Binding CompareSnapshotsCommand}"
                                    FontWeight="SemiBold"/>
                            <TextBox Width="60" Height="35" Margin="0,0,5,0"
                                     Text="{Binding DaysBackFilter, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"/>
                            <Button Content="📊 Analyze Growth" Width="150" Height="35" Margin="0,0,10,0"
                                    Command="{Binding AnalyzeWeeklyGrowthCommand}"
                                    FontWeight="SemiBold"
                                    ToolTip="Analyze top growers over specified days"/>
                            <TextBlock Text="{Binding StatusText}" 
                                       VerticalAlignment="Center" 
                                       Margin="20,0,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Filters -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Filter by Classification:" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,15,0"
                                       FontWeight="SemiBold"/>
                            <CheckBox Content="✅ Safe" 
                                      IsChecked="{Binding ShowSafe}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,15,0"/>
                            <CheckBox Content="⚠️ Caution" 
                                      IsChecked="{Binding ShowCaution}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,15,0"/>
                            <CheckBox Content="🚫 Blocked" 
                                      IsChecked="{Binding ShowBlocked}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,15,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Info Panel -->
                    <Border Grid.Row="2" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Padding="10,5"
                            Margin="0,0,0,10"
                            Background="#FFF9C4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡 Tip: " FontWeight="Bold" Foreground="#F57F17"/>
                            <TextBlock Text="Take snapshots weekly to track install drift. Compare snapshots to see which folders grew the most." 
                                       Foreground="#424242"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Results Section -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <TextBlock Grid.Row="0" 
                                   Text="Recent Growth on C:" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,10"/>

                        <!-- Empty State -->
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GrowthAlerts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                            <TextBlock Text="No growth data available" 
                                       FontSize="16" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="Take a snapshot, wait some time, then compare to see install drift" 
                                       FontSize="12" 
                                       Foreground="Gray"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Growth Alerts DataGrid -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding GrowthAlerts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F5F5F5">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GrowthAlerts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Classification" 
                                                    Binding="{Binding ClassificationText}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Folder Path" 
                                                    Binding="{Binding Path}" 
                                                    Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Previous Size" 
                                                    Binding="{Binding FormattedPreviousSize}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Current Size" 
                                                    Binding="{Binding FormattedCurrentSize}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Growth" 
                                                    Binding="{Binding FormattedDelta}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="%" 
                                                    Binding="{Binding GrowthPercentage}" 
                                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Growth Rate" 
                                                    Binding="{Binding FormattedGrowthRate}" 
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Timestamp" 
                                                    Binding="{Binding FormattedTimestamp}" 
                                                    Width="140"/>
                                <DataGridTemplateColumn Header="Action" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Mark Expected" 
                                                    Width="110"
                                                    Height="25"
                                                    Command="{Binding DataContext.IgnoreGrowthAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Add this path to ignore list"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
