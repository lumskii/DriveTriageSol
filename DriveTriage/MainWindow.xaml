<Window x:Class="DriveTriage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:utils="clr-namespace:DriveTriage.Utils"
        mc:Ignorable="d"
        Title="Drive Triage" Height="600" Width="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <utils:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
        <utils:DriveInfoConverter x:Key="DriveInfoConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <TabControl>
            <!-- Scan Tab -->
            <TabItem Header="Scan">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Scan" Width="100" Margin="0,0,10,0"
                                Command="{Binding ScanCommand}"/>
                        <Button Content="Cancel" Width="100" 
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>

                    <!-- Progress Bar with Percentage -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <ProgressBar Height="25" 
                                     Value="{Binding ProgressValue}" 
                                     Maximum="100"/>
                        <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProgressValue}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Status TextBlock with Scrolling -->
                    <Border Grid.Row="2" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Padding="10,5"
                            Margin="0,0,0,10"
                            Background="#F9F9F9">
                        <TextBlock Text="{Binding StatusText}" 
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatusText}"/>
                    </Border>

                    <!-- ListViews for Files and Folders -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Largest Files -->
                        <GroupBox Grid.Column="0" Header="Largest Files" Margin="0,0,5,0">
                            <ListView ItemsSource="{Binding LargestFiles}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Path" Width="200" 
                                                        DisplayMemberBinding="{Binding Path}"/>
                                        <GridViewColumn Header="Size" Width="80" 
                                                        DisplayMemberBinding="{Binding Size}"/>
                                        <GridViewColumn Header="Last Modified" Width="120" 
                                                        DisplayMemberBinding="{Binding LastModified}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>

                        <!-- Largest Folders -->
                        <GroupBox Grid.Column="1" Header="Largest Folders" Margin="5,0,0,0">
                            <ListView ItemsSource="{Binding LargestFolders}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Path" Width="200" 
                                                        DisplayMemberBinding="{Binding Path}"/>
                                        <GridViewColumn Header="Size" Width="80" 
                                                        DisplayMemberBinding="{Binding Size}"/>
                                        <GridViewColumn Header="Last Modified" Width="120" 
                                                        DisplayMemberBinding="{Binding LastModified}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Recommendations Tab -->
            <TabItem Header="Recommendations">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Scan for Cleanup" Width="140" Margin="0,0,10,0"
                                Command="{Binding ScanBucketsCommand}"/>
                        <Button Content="Cancel" Width="100"
                                Command="{Binding CancelBucketsCommand}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Buckets List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State -->
                            <TextBlock Text="Click 'Scan for Cleanup' to find reclaimable space" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,50,0,0"
                                       FontSize="16" 
                                       Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CleanupBuckets.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Buckets Items -->
                            <ItemsControl ItemsSource="{Binding CleanupBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#CCCCCC" 
                                            BorderThickness="1" 
                                            CornerRadius="5" 
                                            Padding="15" 
                                            Margin="0,0,0,10"
                                            Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Bucket Name -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                       Text="{Binding Name}" 
                                                       FontSize="16" 
                                                       FontWeight="Bold" 
                                                       Margin="0,0,0,5"/>

                                            <!-- Clean Button -->
                                            <Button Grid.Row="0" Grid.Column="1" 
                                                    Content="Clean" 
                                                    Width="100" 
                                                    Height="30"
                                                    Command="{Binding DataContext.CleanBucketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Description}" 
                                                       Foreground="Gray" 
                                                       Margin="0,0,0,10"
                                                       TextWrapping="Wrap"/>

                                            <!-- Statistics -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                        Orientation="Horizontal" 
                                                        Margin="0,0,0,5">
                                                <TextBlock Text="Items: " FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ItemCount}" Margin="0,0,20,0"/>
                                                <TextBlock Text="Reclaimable: " FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ReclaimableSize}" 
                                                           Foreground="#2E7D32" 
                                                           FontWeight="Bold"/>
                                            </StackPanel>

                                            <!-- Status -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding StatusMessage}" 
                                                       FontStyle="Italic" 
                                                       Foreground="#666666"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Apps Tab -->
            <TabItem Header="Apps">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Scan Apps" Width="120" Margin="0,0,10,0"
                                Command="{Binding ScanAppsCommand}"/>
                        <Button Content="Cancel" Width="100" Margin="0,0,10,0"
                                Command="{Binding CancelAppsCommand}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Search:" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" 
                                 Text="{Binding AppsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="25"/>
                    </Grid>

                    <!-- Apps List -->
                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding FilteredApps}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserSortColumns="True"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F5F5F5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application Name" 
                                                Binding="{Binding DisplayName}" 
                                                Width="2*"/>
                            <DataGridTextColumn Header="Publisher" 
                                                Binding="{Binding Publisher}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Version" 
                                                Binding="{Binding DisplayVersion}" 
                                                Width="100"/>
                            <DataGridTextColumn Header="Size" 
                                                Binding="{Binding FormattedSize}" 
                                                Width="80"/>
                            <DataGridTextColumn Header="Install Date" 
                                                Binding="{Binding FormattedInstallDate}" 
                                                Width="100"/>
                            <DataGridTemplateColumn Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Uninstall" 
                                                Width="100"
                                                Height="25"
                                                Command="{Binding DataContext.UninstallAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding UninstallString, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <!-- Empty State -->
                    <TextBlock Grid.Row="2"
                               Text="Click 'Scan Apps' to enumerate installed applications" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               FontSize="16" 
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredApps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- Restore Tab -->
            <TabItem Header="Restore">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Control Panel -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Load Sessions" Width="120" Margin="0,0,10,0"
                                Command="{Binding LoadRestorableSessionsCommand}"/>
                        <TextBlock Text="{Binding StatusText}" 
                                   VerticalAlignment="Center" 
                                   Margin="20,0,0,0"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Sessions List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty State -->
                            <TextBlock Text="Click 'Load Sessions' to view restorable cleanup operations" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,50,0,0"
                                       FontSize="16" 
                                       Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RestorableSessions.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Session Items -->
                            <ItemsControl ItemsSource="{Binding RestorableSessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#CCCCCC" 
                                                BorderThickness="1" 
                                                CornerRadius="5" 
                                                Padding="15" 
                                                Margin="0,0,0,10"
                                                Background="White">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Session Name -->
                                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                                           Text="{Binding BucketName}" 
                                                           FontSize="16" 
                                                           FontWeight="Bold" 
                                                           Margin="0,0,0,5"/>

                                                <!-- Restore Button -->
                                                <Button Grid.Row="0" Grid.Column="1" 
                                                        Content="Restore All" 
                                                        Width="120" 
                                                        Height="30"
                                                        Command="{Binding DataContext.RestoreSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Date/Time -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding FormattedTimestamp, StringFormat='Date: {0}'}" 
                                                           Foreground="Gray" 
                                                           Margin="0,0,0,10"/>

                                                <!-- Statistics -->
                                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                            Orientation="Horizontal" 
                                                            Margin="0,0,0,5">
                                                    <TextBlock Text="Restorable Items: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RestorableCount}" Margin="0,0,20,0" Foreground="#2E7D32" FontWeight="Bold"/>
                                                    <TextBlock Text="Original Size: " FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding FormattedSize}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <!-- Session ID -->
                                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                                           Text="{Binding SessionId, StringFormat='Session ID: {0}'}" 
                                                           FontStyle="Italic" 
                                                           FontSize="10"
                                                           Foreground="#999999"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
